[64.024942, "o", "\u001b[36m╭────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;36mDevMind Repair\u001b[0m — Ollama                                                                                            \u001b[36m│\u001b[0m\r\n\u001b[36m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n\r\n"]
