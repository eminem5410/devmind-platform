[43.813578, "o", " \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mOS                  \u001b[0m\u001b[1m \u001b[0m Linux #15-Ubuntu SMP PREEMPT_DYNAMIC Wed  \u001b[2m \u001b[0m\u001b[2mKernel 7.0.0-15-generic, x86_64          \u001b[0m\u001b[2m \u001b[0m\r\n          \u001b[1m                      \u001b[0m Apr 22 16:06:43 UTC 2026                  \u001b[2m                                           \u001b[0m\r\n \u001b[30;43m [WARN] \u001b[0m \u001b[1m \u001b[0m\u001b[1mPython              \u001b[0m\u001b[1m \u001b[0m 3.14.4                                    \u001b[2m \u001b[0m\u001b[2mVersion muy reciente — puede haber       \u001b[0m\u001b[2m \u001b[0m\r\n          \u001b[1m                      \u001b[0m                                           \u001b[2m \u001b[0m\u001b[2mincompatibilidades con tooling AI        \u001b[0m\u001b[2m \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mCPU                 \u001b[0m\u001b[1m \u001b[0m Intel(R) Core(TM) i5-7400 CPU @ 3.00GHz   \u001b[2m \u001b[0m\u001b[2m                                         \u001b[0m\u001b[2m \u001b[0m\r\n          \u001b[1m                      \u001b[0m (4 cores)                                 \u001b[2m                                           \u001b[0m\r\n \u001b[30;43m [WARN] \u001b[0m \u001b[1m \u001b[0m\u001b[1mRAM                 \u001b[0m\u001b[1m \u001b[0m 3.2 / 7.1 GB (45%)                        \u001b[2m \u001b[0m\u001b[2mRAM limitada para modelos grandes        \u001b[0m\u001b[2m \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mDisco libre         \u001b[0m\u001b[1m \u001b[0m 287.2 GB                                  \u001b[2m \u001b[0m\u001b[2mEspacio suficiente                       \u001b[0m\u001b[2m \u001b[0m\r\n"]
[43.813771, "o", "\r\n"]
[43.813929, "o", "\u001b[1;35mHerramientas\u001b[0m\r\n"]
