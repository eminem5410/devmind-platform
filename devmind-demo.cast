[43.815091, "o", "\r\n"]
[43.815338, "o", "\u001b[1;32mGPU \u001b[0m\u001b[1;32m/\u001b[0m\u001b[1;32m Aceleracion\u001b[0m\r\n"]
[43.816558, "o", " \u001b[30;43m [WARN] \u001b[0m \u001b[1m \u001b[0m\u001b[1mGPU Dedicada        \u001b[0m\u001b[1m \u001b[0m \u001b[2mN/A\u001b[0m                 \u001b[2m \u001b[0m\u001b[2mNo se detectaron GPUs — operando en CPU-only\u001b[0m\u001b[2m \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mVulkan              \u001b[0m\u001b[1m \u001b[0m libvulkan detectada \u001b[2m \u001b[0m\u001b[2m                                            \u001b[0m\u001b[2m \u001b[0m\r\n"]
[43.816613, "o", "\r\n"]
[43.816913, "o", "\u001b[1;34mDocker\u001b[0m\r\n"]
[43.818337, "o", " \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mDocker              \u001b[0m\u001b[1m \u001b[0m 29.4.3     \u001b[2m \u001b[0m\u001b[2m0 contenedores activos, 15 imagenes\u001b[0m\u001b[2m \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mDocker Daemon       \u001b[0m\u001b[1m \u001b[0m ejecutando \u001b[2m \u001b[0m\u001b[2m                                   \u001b[0m\u001b[2m \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mDocker Compose      \u001b[0m\u001b[1m \u001b[0m v5.1.3     \u001b[2m \u001b[0m\u001b[2m                                   \u001b[0m\u001b[2m \u001b[0m\r\n"]
[43.818395, "o", "\r\n"]
[43.818783, "o", "\u001b[1;36mOllama\u001b[0m\r\n"]
[43.820471, "o", " \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mOllama              \u001b[0m\u001b[1m \u001b[0m 0.24.0     \u001b[2m  \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mOllama Server       \u001b[0m\u001b[1m \u001b[0m ejecutando \u001b[2m  \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mOllama Modelos      \u001b[0m\u001b[1m \u001b[0m phi3:mini  \u001b[2m  \u001b[0m\r\n\r\n"]
[43.821382, "o", "\u001b[1mRecomendaciones\u001b[0m\r\n\r\n"]
[43.821843, "o", "  \u001b[33m!\u001b[0m \u001b[1;33mNo se detecto GPU dedicada\u001b[0m\r\n"]
[43.822133, "o", "    \u001b[2mEl sistema opera en modo CPU-only.\u001b[0m\r\n"]
[43.822483, "o", "    \u001b[2mEl rendimiento para inferencia y entrenamiento de modelos sera significativamente menor.\u001b[0m\r\n"]
[43.823044, "o", "    \u001b[2mPara workloads pesados de IA, considera instalar una GPU NVIDIA \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mRTX \u001b[0m\u001b[1;2;36m3060\u001b[0m\u001b[2m o superior con al menos 8GB VRAM\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m.\u001b[0m\r\n"]
[43.823476, "o", "    \u001b[1mAccion:\u001b[0m Instalar una GPU dedicada o usar servicios cloud \u001b[1m(\u001b[0mRunPod, Lambda Labs\u001b[1m)\u001b[0m\r\n"]
[43.823598, "o", "\r\n"]
[43.823931, "o", "  \u001b[33m!\u001b[0m \u001b[1;33mRAM limitada \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33m7.1\u001b[0m\u001b[1;33m GB\u001b[0m\u001b[1;33m)\u001b[0m\r\n"]
[43.824199, "o", "    \u001b[2mCon \u001b[0m\u001b[1;2;36m7.1\u001b[0m\u001b[2m GB de RAM, hay restricciones importantes para modelos de IA.\u001b[0m\r\n"]
[43.824617, "o", "    \u001b[2mLos modelos de 7B+ parametros requieren al menos 8GB solo para inferencia.\u001b[0m\r\n"]
[43.825003, "o", "    \u001b[2mSe recomienda usar modelos pequenos \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2m1B-4B parametros\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m como llama3.\u001b[0m\u001b[1;2;92m2:1b\u001b[0m\u001b[2m, phi3:mini, o gemm\u001b[0m\u001b[1;2;92ma2:2b\u001b[0m\u001b[2m.\u001b[0m\r\n"]
[43.825458, "o", "    \u001b[2mPara entrenamiento, es probable que necesites cuantizacion \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mQ4\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m o LoRA/QLoRA para ajuste fino.\u001b[0m\r\n"]
[43.825859, "o", "    \u001b[1mAccion:\u001b[0m Considerar upgrade de RAM o usar quantization para modelos grandes\r\n"]
[43.825946, "o", "\r\n"]
[43.826278, "o", "  \u001b[33m!\u001b[0m \u001b[1;33mPython \u001b[0m\u001b[1;33m3.14\u001b[0m\u001b[1;33m.\u001b[0m\u001b[1;33m4\u001b[0m\u001b[1;33m \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mversion muy reciente\u001b[0m\u001b[1;33m)\u001b[0m\r\n"]
[43.826897, "o", "    \u001b[2mPython \u001b[0m\u001b[1;2;36m3.14\u001b[0m\u001b[2m.\u001b[0m\u001b[1;2;36m4\u001b[0m\u001b[2m fue lanzado recientemente y muchos frameworks de IA como PyTorch, TensorFlow y scikit-learn pueden \u001b[0m\r\n\u001b[2mno tener compatibilidad oficial aun.\u001b[0m\r\n"]
[43.827554, "o", "    \u001b[2mSe recomienda usar Python \u001b[0m\u001b[1;2;36m3.11\u001b[0m\u001b[2m o \u001b[0m\u001b[1;2;36m3.12\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mLTS\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m como version principal para desarrollo de IA, y reservar \u001b[0m\u001b[1;2;36m3.14\u001b[0m\u001b[2m para \u001b[0m\r\n\u001b[2mtesting.\u001b[0m\r\n"]
[43.827925, "o", "    \u001b[1mAccion:\u001b[0m Considerar usar Python \u001b[1;36m3.12\u001b[0m como version principal para IA\r\n"]
[43.828268, "o", "    \u001b[32m$ pyenv install \u001b[0m\u001b[1;32m3.12\u001b[0m\u001b[32m.\u001b[0m\u001b[1;32m8\u001b[0m\u001b[32m && pyenv global \u001b[0m\u001b[1;32m3.12\u001b[0m\u001b[32m.\u001b[0m\u001b[1;32m8\u001b[0m\r\n"]
[43.828398, "o", "\r\n"]
[43.828737, "o", "  \u001b[36mi\u001b[0m \u001b[1;36mVulkan detectado \u001b[0m\u001b[1;36m(\u001b[0m\u001b[1;36mGPU integrada\u001b[0m\u001b[1;36m)\u001b[0m\r\n"]
[43.829045, "o", "    \u001b[2mVulkan esta disponible a traves de la GPU integrada \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mIntel/AMD\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m.\u001b[0m\r\n"]
[43.829452, "o", "    \u001b[2mAlgunos frameworks pueden usar Vulkan compute shaders, pero el rendimiento es limitado comparado con CUDA o ROCm.\u001b[0m\r\n"]
[43.829518, "o", "\r\n"]
[43.829965, "o", "\u001b[33m╭────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[33m3 advertencia(s) encontradas\u001b[0m                                                                                       \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2m0 reparable(s) automaticamente con 'devmind repair'\u001b[0m                                                                \u001b[33m│\u001b[0m\r\n\u001b[33m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
