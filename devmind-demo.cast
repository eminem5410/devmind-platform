[23.078419, "o", "\u001b[1m                                                                                                                      \u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1;33mUsage: \u001b[0m\u001b[1mdevmind [OPTIONS] COMMAND [ARGS]...\u001b[0m\u001b[1m                                                                          \u001b[0m\u001b[1m \u001b[0m\r\n\u001b[1m                                                                                                                      \u001b[0m\r\n"]
[23.082281, "o", " DevMind Platform — Herramientas CLI para desarrollo de IA en Linux                                                   \r\n                                                                                                                      \r\n"]
[23.085601, "o", "\u001b[2m╭─\u001b[0m\u001b[2m Options \u001b[0m\u001b[2m─────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[2m─╮\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-help\u001b[0m          Show this message and exit.                                                                        \u001b[2m│\u001b[0m\r\n\u001b[2m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[23.087358, "o", "\u001b[2m╭─\u001b[0m\u001b[2m Commands \u001b[0m\u001b[2m────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[2m─╮\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mdoctor\u001b[0m\u001b[1;36m \u001b[0m Diagnostica el sistema, detecta problemas y genera recomendaciones.                                        \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mgpu   \u001b[0m\u001b[1;36m \u001b[0m Verifica GPUs, drivers CUDA y Vulkan.                                                                      \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36minit  \u001b[0m\u001b[1;36m \u001b[0m Inicializa un proyecto de IA con estructura estandar.                                                      \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36msetup \u001b[0m\u001b[1;36m \u001b[0m Configura un ambiente completo de desarrollo AI.                                                           \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mrepair\u001b[0m\u001b[1;36m \u001b[0m Repara automaticamente problemas detectados por devmind doctor                                             \u001b[2m│\u001b[0m\r\n\u001b[2m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
