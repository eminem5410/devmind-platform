[11.436137, "o", " \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mOS                  \u001b[0m\u001b[1m \u001b[0m Linux #15-Ubuntu SMP PREEMPT_DYNAMIC Wed  \u001b[2m \u001b[0m\u001b[2mKernel 7.0.0-15-generic, x86_64          \u001b[0m\u001b[2m \u001b[0m\r\n          \u001b[1m                      \u001b[0m Apr 22 16:06:43 UTC 2026                  \u001b[2m                                           \u001b[0m\r\n \u001b[30;43m [WARN] \u001b[0m \u001b[1m \u001b[0m\u001b[1mPython              \u001b[0m\u001b[1m \u001b[0m 3.14.4                                    \u001b[2m \u001b[0m\u001b[2mVersion muy reciente — puede haber       \u001b[0m\u001b[2m \u001b[0m\r\n          \u001b[1m                      \u001b[0m                                           \u001b[2m \u001b[0m\u001b[2mincompatibilidades con tooling AI        \u001b[0m\u001b[2m \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mCPU                 \u001b[0m\u001b[1m \u001b[0m Intel(R) Core(TM) i5-7400 CPU @ 3.00GHz   \u001b[2m \u001b[0m\u001b[2m                                         \u001b[0m\u001b[2m \u001b[0m\r\n          \u001b[1m                      \u001b[0m (4 cores)                                 \u001b[2m                                           \u001b[0m\r\n \u001b[30;43m [WARN] \u001b[0m \u001b[1m \u001b[0m\u001b[1mRAM                 \u001b[0m\u001b[1m \u001b[0m 3.5 / 7.1 GB (49%)                        \u001b[2m \u001b[0m\u001b[2mRAM limitada para modelos grandes        \u001b[0m\u001b[2m \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mDisco libre         \u001b[0m\u001b[1m \u001b[0m 287.5 GB                                  \u001b[2m \u001b[0m\u001b[2mEspacio suficiente                       \u001b[0m\u001b[2m \u001b[0m\r\n"]
[11.436299, "o", "\r\n"]
[11.436525, "o", "\u001b[1;35mHerramientas\u001b[0m\r\n"]
[11.437605, "o", " \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mGit                 \u001b[0m\u001b[1m \u001b[0m instalado \u001b[2m \u001b[0m\u001b[2mControl de versiones disponible\u001b[0m\u001b[2m \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mpip                 \u001b[0m\u001b[1m \u001b[0m instalado \u001b[2m \u001b[0m\u001b[2m                               \u001b[0m\u001b[2m \u001b[0m\r\n"]
[11.437761, "o", "\r\n"]
[11.43799, "o", "\u001b[1;32mGPU \u001b[0m\u001b[1;32m/\u001b[0m\u001b[1;32m Aceleracion\u001b[0m\r\n"]
[11.439397, "o", " \u001b[30;43m [WARN] \u001b[0m \u001b[1m \u001b[0m\u001b[1mGPU Dedicada        \u001b[0m\u001b[1m \u001b[0m \u001b[2mN/A\u001b[0m                 \u001b[2m \u001b[0m\u001b[2mNo se detectaron GPUs — operando en CPU-only\u001b[0m\u001b[2m \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mVulkan              \u001b[0m\u001b[1m \u001b[0m libvulkan detectada \u001b[2m \u001b[0m\u001b[2m                                            \u001b[0m\u001b[2m \u001b[0m\r\n\r\n"]
[11.440133, "o", "\u001b[1;34mDocker\u001b[0m\r\n"]
[11.441999, "o", " \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mDocker              \u001b[0m\u001b[1m \u001b[0m 29.4.3     \u001b[2m \u001b[0m\u001b[2m0 contenedores activos, 15 imagenes\u001b[0m\u001b[2m \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mDocker Daemon       \u001b[0m\u001b[1m \u001b[0m ejecutando \u001b[2m \u001b[0m\u001b[2m                                   \u001b[0m\u001b[2m \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mDocker Compose      \u001b[0m\u001b[1m \u001b[0m v5.1.3     \u001b[2m \u001b[0m\u001b[2m                                   \u001b[0m\u001b[2m \u001b[0m\r\n\r\n"]
[11.442453, "o", "\u001b[1;36mOllama\u001b[0m\r\n"]
[11.443555, "o", " \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mOllama              \u001b[0m\u001b[1m \u001b[0m 0.24.0     \u001b[2m  \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mOllama Server       \u001b[0m\u001b[1m \u001b[0m ejecutando \u001b[2m  \u001b[0m\r\n \u001b[30;46m [INFO] \u001b[0m \u001b[1m \u001b[0m\u001b[1mOllama Modelos      \u001b[0m\u001b[1m \u001b[0m phi3:mini  \u001b[2m  \u001b[0m\r\n"]
[11.443711, "o", "\r\n"]
[11.443864, "o", "\u001b[1mRecomendaciones\u001b[0m\r\n"]
[11.444472, "o", "\r\n  \u001b[33m!\u001b[0m \u001b[1;33mNo se detecto GPU dedicada\u001b[0m\r\n"]
[11.444689, "o", "    \u001b[2mEl sistema opera en modo CPU-only.\u001b[0m\r\n"]
[11.445087, "o", "    \u001b[2mEl rendimiento para inferencia y entrenamiento de modelos sera significativamente menor.\u001b[0m\r\n"]
[11.44543, "o", "    \u001b[2mPara workloads pesados de IA, considera instalar una GPU NVIDIA \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mRTX \u001b[0m\u001b[1;2;36m3060\u001b[0m\u001b[2m o superior con al menos 8GB VRAM\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m.\u001b[0m\r\n"]
[11.445815, "o", "    \u001b[1mAccion:\u001b[0m Instalar una GPU dedicada o usar servicios cloud \u001b[1m(\u001b[0mRunPod, Lambda Labs\u001b[1m)\u001b[0m\r\n"]
[11.44594, "o", "\r\n"]
[11.446421, "o", "  \u001b[33m!\u001b[0m \u001b[1;33mRAM limitada \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33m7.1\u001b[0m\u001b[1;33m GB\u001b[0m\u001b[1;33m)\u001b[0m\r\n"]
[11.447392, "o", "    \u001b[2mCon \u001b[0m\u001b[1;2;36m7.1\u001b[0m\u001b[2m GB de RAM, hay restricciones importantes para modelos de IA.\u001b[0m\r\n"]
[11.447943, "o", "    \u001b[2mLos modelos de 7B+ parametros requieren al menos 8GB solo para inferencia.\u001b[0m\r\n"]
[11.448444, "o", "    \u001b[2mSe recomienda usar modelos pequenos \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2m1B-4B parametros\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m como llama3.\u001b[0m\u001b[1;2;92m2:1b\u001b[0m\u001b[2m, phi3:mini, o gemm\u001b[0m\u001b[1;2;92ma2:2b\u001b[0m\u001b[2m.\u001b[0m\r\n"]
[11.448977, "o", "    \u001b[2mPara entrenamiento, es probable que necesites cuantizacion \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mQ4\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m o LoRA/QLoRA para ajuste fino.\u001b[0m\r\n"]
[11.449214, "o", "    \u001b[1mAccion:\u001b[0m Considerar upgrade de RAM o usar quantization para modelos grandes\r\n"]
[11.449348, "o", "\r\n"]
[11.449745, "o", "  \u001b[33m!\u001b[0m \u001b[1;33mPython \u001b[0m\u001b[1;33m3.14\u001b[0m\u001b[1;33m.\u001b[0m\u001b[1;33m4\u001b[0m\u001b[1;33m \u001b[0m\u001b[1;33m(\u001b[0m\u001b[1;33mversion muy reciente\u001b[0m\u001b[1;33m)\u001b[0m\r\n"]
[11.450211, "o", "    \u001b[2mPython \u001b[0m\u001b[1;2;36m3.14\u001b[0m\u001b[2m.\u001b[0m\u001b[1;2;36m4\u001b[0m\u001b[2m fue lanzado recientemente y muchos frameworks de IA como PyTorch, TensorFlow y scikit-learn pueden \u001b[0m\r\n\u001b[2mno tener compatibilidad oficial aun.\u001b[0m\r\n"]
[11.450801, "o", "    \u001b[2mSe recomienda usar Python \u001b[0m\u001b[1;2;36m3.11\u001b[0m\u001b[2m o \u001b[0m\u001b[1;2;36m3.12\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mLTS\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m como version principal para desarrollo de IA, y reservar \u001b[0m\u001b[1;2;36m3.14\u001b[0m\u001b[2m para \u001b[0m\r\n\u001b[2mtesting.\u001b[0m\r\n"]
[11.451127, "o", "    \u001b[1mAccion:\u001b[0m Considerar usar Python \u001b[1;36m3.12\u001b[0m como version principal para IA\r\n"]
[11.451698, "o", "    \u001b[32m$ pyenv install \u001b[0m\u001b[1;32m3.12\u001b[0m\u001b[32m.\u001b[0m\u001b[1;32m8\u001b[0m\u001b[32m && pyenv global \u001b[0m\u001b[1;32m3.12\u001b[0m\u001b[32m.\u001b[0m\u001b[1;32m8\u001b[0m\r\n\r\n"]
[11.452035, "o", "  \u001b[36mi\u001b[0m \u001b[1;36mVulkan detectado \u001b[0m\u001b[1;36m(\u001b[0m\u001b[1;36mGPU integrada\u001b[0m\u001b[1;36m)\u001b[0m\r\n"]
[11.452411, "o", "    \u001b[2mVulkan esta disponible a traves de la GPU integrada \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mIntel/AMD\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m.\u001b[0m\r\n"]
[11.452816, "o", "    \u001b[2mAlgunos frameworks pueden usar Vulkan compute shaders, pero el rendimiento es limitado comparado con CUDA o ROCm.\u001b[0m\r\n"]
[11.453039, "o", "\r\n"]
[11.456567, "o", "\u001b[33m╭────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[33m3 advertencia(s) encontradas\u001b[0m                                                                                       \u001b[33m│\u001b[0m\r\n\u001b[33m│\u001b[0m \u001b[2m0 reparable(s) automaticamente con 'devmind repair'\u001b[0m                                                                \u001b[33m│\u001b[0m\r\n\u001b[33m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[11.456699, "o", "\r\n"]
[11.524121, "o", "\u001b]666;vte.shell.postexec=0\u001b\\"]
