[68.774814, "o", "\u001b[3m                                     Comparacion de Costos: Local vs API                                     \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━┳━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mModelo                  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mProveedor \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mInput/1M\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mOutput/1M\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mCosto Diario\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mCosto Mensual\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mCosto Anual\u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━╇━━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━┩\r\n│\u001b[1m \u001b[0m\u001b[1;32mlocal-model\u001b[0m\u001b[1m             \u001b[0m\u001b[1m \u001b[0m│ Local      │    $0.00 │     $0.00 │\u001b[1m \u001b[0m\u001b[1m     $0.2400\u001b[0m\u001b[1m \u001b[0m│\u001b[1m \u001b[0m\u001b[1m        $7.20\u001b[0m\u001b[1m \u001b[0m│      $87.60 │\r\n├──────────────────────────┼────────────┼──────────┼───────────┼──────────────┼───────────────┼─────────────┤\r\n│\u001b[1m \u001b[0m\u001b[1mllama-3.1-8b            \u001b[0m\u001b[1m \u001b[0m│ groq       │  $0.0000 │   $0.0001 │\u001b[1m \u001b[0m\u001b[1m     $0.0029\u001b[0m\u001b[1m \u001b[0m│\u001b[1m \u001b[0m\u001b[1m        $0.09\u001b[0m\u001b[1m \u001b[0m│       $1.07 │\r\n├──────────────────────────┼────────────┼──────────┼───────────┼──────────────┼───────────────┼─────────────┤\r\n│\u001b[1m \u001b[0m\u001b[1mllama-3.1-8b            \u001b[0m\u001b[1m \u001b[0m│ cerebras   │  $0.0001 │   $0.0001 │\u001b[1m \u001b[0m\u001b[1m     $0.0045\u001b[0m\u001b[1m \u001b[0m│\u001b[1m \u001b[0m\u001b[1m        $0.14\u001b[0m\u001b[1m \u001b[0m│       $1.64 │\r\n├──────────────────────────┼────────────┼──────────┼──────────