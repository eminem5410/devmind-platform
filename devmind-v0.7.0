[60.259506, "o", "  \u001b[32mOK\u001b[0m \u001b[1;36m5.90\u001b[0m tokens/s | TTFT: 4751ms | RAM: 3739MB\r\n\r\n\r\n\u001b[36m╭────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[1;36mDevMind Benchmark\u001b[0m — Rendimiento de modelos Ollama                                                                  \u001b[36m│\u001b[0m\r\n\u001b[36m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n\r\n"]
[60.270733, "o", "  \u001b[2mHardware: \u001b[0m\u001b[1;2;35mIntel\u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mR\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m \u001b[0m\u001b[1;2;35mCore\u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mTM\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m i5-\u001b[0m\u001b[1;2;36m7400\u001b[0m\u001b[2m CPU @ \u001b[0m\u001b[1;2;36m3.\u001b[0m\u001b[2m00GHz \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2m4c\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m, \u001b[0m\u001b[1;2;36m7.1\u001b[0m\u001b[2m GB RAM\u001b[0m\r\n\r\n  \u001b[1mRun \u001b[0m\u001b[1;36m1\u001b[0m — \u001b[36mphi3:mini\u001b[0m\r\n\r\n\u001b[1m  \u001b[0m\u001b[1mThroughput            \u001b[0m\u001b[1m  \u001b[0m  \u001b[33m5.90 tokens/s\u001b[0m (Aceptable)  \r\n\u001b[1m  \u001b[0m\u001b[1mTTFT (Time to First   \u001b[0m\u001b[1m  \u001b[0m  4751 ms                    \r\n\u001b[1m  \u001b[0m\u001b[1mToken)                \u001b[0m\u001b[1m  \u001b[0m                             \r\n\u001b[1m  \u001b[0m\u001b[1mTotal time            \u001b[0m\u001b[1m  \u001b[0m  28823 ms                   \r\n\u001b[1m  \u001b[0m\u001b[1mTokens generados      \u001b[0m\u001b[1m  \u001b[0m  142 tokens                 \r\n\u001b[1m  \u001b[0m\u001b[1mRAM pico Ollama       \u001b[0m\u001b[1m  \u001b[0m  3739 MB                    \r\n\u001b[1m  \u001b[0m\u001b[1mRAM delta             \u001b[0m\u001b[1m  \u001b[0m  \u001b[33m+3666 MB\u001b[0m                   \r\n\r\n  \u001b[2mRespuesta: \u001b[0m\u001b[2;32m\"Machine learning is a subset of artificial intelligence that uses statistical te...\"\u001b[0m\r\n\r\n\u001b[1mResumen\u001b[0m\r\n\r\n"]
[60.270934, "o", "\u001b[1m  \u001b[0m\u001b[1mBenchmarks OK            \u001b[0m\u001b[1m  \u001b[0m  1/1                   \r\n\u001b[1m  \u001b[0m\u001b[1mAvg throughput           \u001b[0m\u001b[1m  \u001b[0m  \u001b[33m5.90 tokens/s\u001b[0m         \r\n\u001b[1m  \u001b[0m\u001b[1mRange                    \u001b[0m\u001b[1m  \u001b[0m  5.90 — 5.90 tokens/s  \r\n\u001b[1m  \u001b[0m\u001b[1mAvg TTFT                 \u001b[0m\u001b[1m  \u001b[0m  4751 ms               \r\n\u001b[1m  \u001b[0m\u001b[1mAvg RAM pico             \u001b[0m\u001b[1m  \u001b[0m  3739 MB               \r\n\u001b[1m  \u001b[0m\u001b[1mTotal tokens             \u001b[0m\u001b[1m  \u001b[0m  157                   \r\n\u001b[1m  \u001b[0m\u001b[1mModelos                  \u001b[0m\u001b[1m  \u001b[0m  phi3:mini             \r\n\r\n\u001b[2mTips para mejorar rendimiento:\u001b[0m\r\n\u001b[2m  - Cuantizacion: usar modelos Q4 en vez de Q8 o FP16\u001b[0m\r\n\u001b[2m  - GPU: NVIDIA con CUDA es \u001b[0m\u001b[1;2;36m10\u001b[0m\u001b[2m-5\u001b[0m\u001b[1;2;36m0x\u001b[0m\u001b[2m mas rapido que CPU\u001b[0m\r\n\u001b[2m  - Contexto: prompts cortos = menos RAM y mas rapido\u001b[0m\r\n\u001b[2m  - num_ctx: reducir si no necesitas contexto largo\u001b[0m\r\n\r\n"]
